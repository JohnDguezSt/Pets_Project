# Copia este archivo como .env.local y rellena los valores en tu equipo.
# Nunca subas .env.local ni claves al repositorio (el repositorio es público).

# Supabase. Solo la URL y la clave PUBLICABLE (sb_publishable_…): ambas son públicas
# y la protección real está en RLS. La clave secreta / service_role NUNCA va aquí.
# En local, los valores salen de `supabase status` (API_URL y PUBLISHABLE_KEY).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
